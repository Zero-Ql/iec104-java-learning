<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="523.0" prefWidth="340.0" stylesheets="@../css/Iec104MasterCommunicationParameters.css"
            xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cloud.yunyat.controller.iec104.addDeviceController">
    <center>
        <VBox prefHeight="553.0" prefWidth="366.0" styleClass="Iec104MasterCommunicationParameters">
            <Label prefHeight="19.0" prefWidth="366.0"/>
            <GridPane>
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="178.0" minWidth="10.0" prefWidth="98.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="268.0" minWidth="10.0" prefWidth="268.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                </rowConstraints>
                <Label text="设备名称"/>
                <TextField fx:id="deviceNameField" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.valignment="CENTER"/>
            </GridPane>
            <StackPane alignment="TOP_LEFT" styleClass="connection-container">
                <padding>
                    <Insets top="20"/>
                </padding>

                <VBox styleClass="connection-border">
                    <padding>
                        <Insets bottom="15" left="15" right="15" top="15"/>
                    </padding>

                    <GridPane hgap="15" vgap="5">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="70.0"/>
                            <ColumnConstraints/>
                        </columnConstraints>
                        <Label text="IP Address" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="ipNameField" text="127.0.0.1" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label text="Port" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="portNameField" text="2404" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>
                    </GridPane>
                </VBox>

                <Label styleClass="connection-title" text="通信参数">
                    <StackPane.margin>
                        <Insets left="12"/>
                    </StackPane.margin>
                </Label>
            </StackPane>
            <StackPane alignment="TOP_LEFT" styleClass="connection-container">
                <padding>
                    <Insets top="20"/>
                </padding>
                <VBox spacing="10" styleClass="connection-border">
                    <padding>
                        <Insets bottom="15" left="15" right="15" top="15"/>
                    </padding>
                    <GridPane hgap="10" vgap="5">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="40.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="70"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="100.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="40.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="70"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="100.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>
                        <Label maxWidth="20" text="T1"/>
                        <Label text="T2" GridPane.rowIndex="1"/>
                        <Label text="T3" GridPane.columnIndex="3"/>
                        <Label text="W" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <TextField fx:id="t1NameField" maxWidth="40" text="15" GridPane.columnIndex="1"/>
                        <TextField fx:id="t2NameField" maxWidth="40" text="10" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="t3NameField" maxWidth="40" text="15" GridPane.columnIndex="4"/>
                        <TextField fx:id="wNameField" maxWidth="40" text="8" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                        <Label text="(范围:1-255s)" GridPane.columnIndex="2">
                            <tooltip>
                                <Tooltip text="范围:1-255s"/>
                            </tooltip>
                        </Label>
                        <Label text="(范围:1-255s)" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <tooltip>
                                <Tooltip text="范围:1-255s"/>
                            </tooltip>
                        </Label>
                        <Label text="(范围:1-255s)" GridPane.columnIndex="5">
                            <tooltip>
                                <Tooltip text="范围:1-255s"/>
                            </tooltip>
                        </Label>
                        <Label text="(范围:1-32767)" GridPane.columnIndex="5" GridPane.rowIndex="1">
                            <tooltip>
                                <Tooltip text="范围:1-32767"/>
                            </tooltip>
                        </Label>
                    </GridPane>
                    <Label alignment="CENTER" maxWidth="Infinity" text="Tips：(w)最大没有确认的I帧数量"
                           VBox.vgrow="ALWAYS"/>
                </VBox>
                <Label styleClass="connection-title" text="超时参数">
                    <StackPane.margin>
                        <Insets left="12"/>
                    </StackPane.margin>
                </Label>
            </StackPane>
            <StackPane alignment="TOP_LEFT" styleClass="connection-container">
                <padding>
                    <Insets top="20"/>
                </padding>
                <VBox spacing="10" styleClass="connection-border">
                    <padding>
                        <Insets bottom="15" left="15" right="15" top="15"/>
                    </padding>
                    <GridPane hgap="5" vgap="5">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="70.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="25"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>
                        <Label alignment="CENTER" maxWidth="Infinity" text="总召轮询周期"
                               VBox.vgrow="ALWAYS"/>
                        <Label alignment="CENTER" maxWidth="Infinity" text="时钟同步轮询周期"
                               GridPane.rowIndex="1" VBox.vgrow="ALWAYS"/>
                        <TextField fx:id="generalInterrogationNameField" maxWidth="40" text="600" GridPane.columnIndex="1"/>
                        <TextField fx:id="clockSynchronizationNameField" maxWidth="40" text="0" GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>
                        <Label text="(单位:s)" GridPane.columnIndex="2"/>
                        <Label text="(单位:s)" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>
                <Label styleClass="connection-title" text="轮询周期">
                    <StackPane.margin>
                        <Insets left="12"/>
                    </StackPane.margin>
                </Label>
            </StackPane>
            <StackPane alignment="TOP_LEFT" styleClass="connection-container">
                <padding>
                    <Insets top="20"/>
                </padding>
                <VBox spacing="10" styleClass="connection-border">
                    <padding>
                        <Insets bottom="15" left="15" right="15" top="15"/>
                    </padding>
                    <GridPane hgap="5" vgap="5">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="20.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="40"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="40.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints/>
                        </rowConstraints>
                        <TextField fx:id="gmtField" alignment="CENTER" text="1"
                                   GridPane.columnIndex="1"/>
                        <CheckBox fx:id="enableTimezoneCheck" alignment="CENTER" maxWidth="Infinity"
                                  mnemonicParsing="false" text="是否启用" GridPane.columnIndex="2"
                                  VBox.vgrow="ALWAYS"/>
                        <Label alignment="CENTER" maxWidth="Infinity" text="GMT" VBox.vgrow="ALWAYS"/>
                    </GridPane>
                </VBox>
                <Label styleClass="connection-title" text="时区设置">
                    <StackPane.margin>
                        <Insets left="12"/>
                    </StackPane.margin>
                </Label>
            </StackPane>
            <GridPane hgap="30">
                <padding>
                    <Insets top="20"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="50.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="50.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                </rowConstraints>
                <Button maxWidth="70" mnemonicParsing="false" text="确定" onAction="#createBtn" GridPane.halignment="RIGHT"
                        GridPane.valignment="CENTER" VBox.vgrow="ALWAYS"/>
                <Button maxWidth="70" mnemonicParsing="false" text="取消" onAction="#cancelBtn" GridPane.columnIndex="1"
                        GridPane.halignment="LEFT" GridPane.valignment="CENTER" VBox.vgrow="ALWAYS"/>
            </GridPane>
        </VBox>
    </center>
    <bottom>
        <HBox prefHeight="30">
            <padding>
                <Insets top="13" left="5" right="10"/>
            </padding>

            <!-- 底栏状态信息 -->
            <HBox spacing="20">
                <Label fx:id="Tips" text="就绪"/>
            </HBox>
        </HBox>
    </bottom>
</BorderPane>
