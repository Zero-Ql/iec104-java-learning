<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="450.0" prefWidth="480.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/21.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cloud.yunyat.controller.iec104.addYcDataController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
        <GridPane hgap="10.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="80.0" prefWidth="90.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField text="Tag12" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Type" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox prefWidth="200.0" promptText="Measured Float" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="SBO" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox disable="true" prefWidth="200.0" promptText="Direct Operate" GridPane.columnIndex="1"
                      GridPane.rowIndex="2"/>

            <Label text="Qualifier" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox disable="true" prefWidth="200.0" promptText="No Pulse" GridPane.columnIndex="1"
                      GridPane.rowIndex="3"/>

            <Label text="IOA" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField maxWidth="80.0" prefWidth="80.0" text="1" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="IOA Structure" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                <TextField prefWidth="40.0" text="0"/>
                <Label text="/"/>
                <TextField prefWidth="40.0" text="0"/>
                <Label text="/"/>
                <TextField prefWidth="40.0" text="1"/>
            </HBox>

            <CheckBox text="Enable Structure IOA" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        </GridPane>

        <StackPane alignment="TOP_LEFT">
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
            <VBox spacing="15.0" style="-fx-border-color: #D0D0D0; -fx-border-width: 1px; -fx-padding: 20 10 10 10;">
                <StackPane.margin>
                    <Insets top="10.0"/>
                </StackPane.margin>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <CheckBox text="Enable Scale"/>
                    <RadioButton disable="true" text="Linear">
                        <toggleGroup>
                            <ToggleGroup fx:id="scaleGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton disable="true" text="Scale Factor" toggleGroup="$scaleGroup"/>
                </HBox>

                <StackPane alignment="TOP_LEFT">
                    <VBox style="-fx-border-color: #D0D0D0; -fx-border-width: 1px; -fx-padding: 20 10 10 10;">
                        <StackPane.margin>
                            <Insets top="10.0"/>
                        </StackPane.margin>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" prefWidth="60.0"/>
                                <ColumnConstraints prefWidth="60.0"/>
                                <ColumnConstraints halignment="CENTER" prefWidth="15.0"/>
                                <ColumnConstraints prefWidth="60.0"/>
                            </columnConstraints>
                            <Label text="Raw" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="-" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <TextField text="0" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                            <Label text="Scale To" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="-" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <TextField text="0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>
                    <Label style="-fx-background-color: #F4F4F4; -fx-padding: 0 5 0 5; -fx-translate-x: 10;"
                           text="Linear"/>
                </StackPane>

                <StackPane alignment="TOP_LEFT">
                    <VBox style="-fx-border-color: #D0D0D0; -fx-border-width: 1px; -fx-padding: 20 10 10 10;">
                        <StackPane.margin>
                            <Insets top="10.0"/>
                        </StackPane.margin>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label alignment="CENTER_RIGHT" prefWidth="50.0" text="Factor"/>
                            <TextField prefWidth="60.0" text="0"/>
                        </HBox>
                    </VBox>
                    <Label style="-fx-background-color: #F4F4F4; -fx-padding: 0 5 0 5; -fx-translate-x: 10;"
                           text="Scale Factor"/>
                </StackPane>
            </VBox>
            <Label style="-fx-background-color: #F4F4F4; -fx-padding: 0 5 0 5; -fx-translate-x: 10;"
                   text="Analog Parameter"/>
        </StackPane>
    </VBox>

    <VBox spacing="10.0">
        <Button prefWidth="80.0" text="OK"/>
        <Button prefWidth="80.0" text="Cancel"/>
    </VBox>
</HBox>